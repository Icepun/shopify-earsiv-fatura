# ─── Shopify Admin API ───────────────────────────────────────────
SHOPIFY_STORE=magicland-3d.myshopify.com

# Shopify Dev Dashboard (dev.shopify.com) > uygulamanız > Ayarlar >
# Kimlik bilgileri. İki değeri de buraya yazın.
# Önce: uygulamanın sürümünde read_orders, write_orders, read_customers
# izinlerini seçin ve uygulamayı bu mağazaya kurun.
SHOPIFY_ISTEMCI_KIMLIGI=
SHOPIFY_GIZLI_ANAHTAR=

# Eskiden Shopify Admin'den alınan shpat_... tokeni varsa onu da
# kullanabilirsiniz. Shopify artık yeni bu tür uygulama açtırmıyor;
# yukarıdaki iki alan doluysa buranın boş kalması normaldir.
SHOPIFY_TOKEN=

# ─── GİB e-Arşiv Portal ──────────────────────────────────────────
# İnternet Vergi Dairesi kullanıcı kodu ve şifresi
GIB_KULLANICI_KODU=
GIB_SIFRE=
# Gerçek fatura kesmek için false, denemek için true
GIB_TEST_MODU=true

# ─── Fatura ayarları ─────────────────────────────────────────────
KDV_ORANI=20
# Kargo bedeli ürün satırlarına dağıtılsın mı? (evet = ayrı satır yok)
KARGOYU_DAGIT=true
# Faturaya düşülecek not (boş bırakılabilir)
FATURA_NOTU=

# Panelde tarih aralığının varsayılan başlangıcı (YYYY-AA-GG).
# Boş = filtre yok, bütün faturalanmamış siparişler listelenir.
BASLANGIC_TARIHI=
