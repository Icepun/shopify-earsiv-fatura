# ─── Shopify Admin API ───────────────────────────────────────────
# Shopify Admin > Settings > Apps and sales channels > Develop apps
# > Create an app > Configure Admin API scopes:
#     read_orders, write_orders, read_customers
# > Install app > Reveal Admin API access token
SHOPIFY_STORE=magicland-3d.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── GİB e-Arşiv Portal ──────────────────────────────────────────
# İnternet Vergi Dairesi kullanıcı kodu ve şifresi
GIB_KULLANICI_KODU=
GIB_SIFRE=
# Gerçek fatura kesmek için false, denemek için true
GIB_TEST_MODU=true

# ─── Fatura ayarları ─────────────────────────────────────────────
KDV_ORANI=20
# Kargo bedeli ürün satırlarına dağıtılsın mı? (evet = ayrı satır yok)
KARGOYU_DAGIT=true
# Faturaya düşülecek not (boş bırakılabilir)
FATURA_NOTU=
